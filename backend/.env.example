# Copy this file to backend/.env and fill it in. NEVER commit backend/.env (it is gitignored).
# The frontend must never see any of these values; it only talks to the Flask API.
# Needs python-dotenv:  python -m pip install -r requirements_forum.txt
# (If backend/.env exists but python-dotenv is missing, the app refuses to start rather than
#  silently ignoring this file and falling back to SQLite.)

# ---- Neon PostgreSQL ------------------------------------------------------
# Used by the running app (forum_api.py). Use Neon's POOLED connection string
# (the host contains "-pooler"). Leave empty to keep using local SQLite.
# Check it with:  python check_pooled_connection.py   (read-only: connect + SELECT 1)
DATABASE_URL=
# Used ONLY by migrate_sqlite_to_postgres.py. Use Neon's DIRECT (non-pooled) string;
# the migration never uses DATABASE_URL and refuses a host containing "-pooler".
# If this is set, DATABASE_URL must be set too, otherwise startup stops (no silent SQLite).
DATABASE_URL_DIRECT=
# Example shape (copy the real ones from the Neon dashboard):
#   pooled : postgresql://USER:PASSWORD@ep-xxxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
#   direct : postgresql://USER:PASSWORD@ep-xxxxx.REGION.aws.neon.tech/DBNAME?sslmode=require

# ---- Security -------------------------------------------------------------
# REQUIRED whenever DATABASE_URL points at PostgreSQL: at least 32 characters and not the
# development placeholder, otherwise startup stops. Also needed to run the migration script.
# Changing it later signs every user out. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# (Not required for local SQLite development.)
JWT_SECRET_KEY=

# ---- Optional -------------------------------------------------------------
# Demo admin + sample posts. Default: on for SQLite, off for PostgreSQL.
# SEED_DEMO_DATA=0
